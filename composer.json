{
  "name": "reactphp-x/reactphp-x",
  "description": "Laravel-like project skeleton using ReactPHP-X (routes, logging, database)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "reactphp-x/route": "^1.0",
    "reactphp-x/log": "^1.0",
    "wpjscc/filesystem": "0.2.0",
    "vlucas/phpdotenv": "^5.6",
    "php-di/php-di": "^7.0",
    "reactphp-x/cycle-orm": "dev-master",
    "zircote/swagger-php": "^5.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },  
    "files": [
      "bootstrap/helpers.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,

  "scripts": {
    "start": "php -d variables_order=EGPCS index.php",
    "hello": "php app/Commands/hello.php",
    "db-example": "php app/Commands/database-example.php"
  },
  "require-dev": {
    "wpjscc/migrations": "4.x-dev"
  }
}
