APP_NAME=ReactPHPX
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=debug
X_LISTEN=127.0.0.1:8080

DB_CONNECTION=default
# Supported drivers: mysql, sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# mysql: database name | sqlite: file path or :memory:
DB_DATABASE=test
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_QUEUE=1000
DB_POOL_TIMEOUT=0
